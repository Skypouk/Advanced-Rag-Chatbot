# Copy to .env and adjust as needed:  cp .env.example .env
# docker-compose reads this file automatically. Inside Docker, OLLAMA_BASE_URL
# and CHROMA_PERSIST_DIR are overridden in docker-compose.yml.

# ── Ollama ──────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TEMPERATURE=0.1
OLLAMA_REQUEST_TIMEOUT=300
# nomic-embed-text task prefixes are applied automatically; set to override.
# EMBED_DOCUMENT_PREFIX="search_document: "
# EMBED_QUERY_PREFIX="search_query: "

# ── Storage ─────────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=rag_sentences
DOCUMENT_STORE_DIR=./document_store

# ── Sentence segmentation ───────────────────────────────────────────────────
MAX_SENTENCE_CHARS=600
TEXT_PAGE_CHARS=4000

# ── Retrieval / evidence ────────────────────────────────────────────────────
RETRIEVAL_TOP_K=8
EVIDENCE_WINDOW=1
MAX_CHAT_HISTORY=6

# ── API limits ──────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50
MAX_QUERY_LENGTH=4000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
